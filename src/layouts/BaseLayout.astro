---
// base page shell
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { person } from '../data/site';
import { portraits } from '../data/gallery';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = `In loving memory of ${person.fullName} (${person.praiseName}), ${person.born} – ${person.died}. Her story, tributes, photographs and funeral arrangements.`,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${person.firstName} ${person.christianName} ${person.surname}`
  : `${person.fullName} (${person.born} – ${person.died}) · ${person.praiseName}`;

const canonical = new URL(Astro.url.pathname, Astro.site);
// jpg for the share preview, whatsapp does not like avif
const og = await getImage({ src: portraits.redGele, width: 434, format: 'jpg', quality: 78 });
const ogUrl = new URL(og.src, Astro.site);
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#172c57" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icons/icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />

    <Font cssVariable="--font-display" preload={[{ weight: '600', style: 'normal' }]} />
    <Font cssVariable="--font-script" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`In memory of ${person.fullName}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta property="og:image:alt" content={`${person.fullName} smiling in a red head-tie`} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />

    <p class="net-status" role="status" aria-live="polite" hidden></p>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />

    <script>
      // register sw after load
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        addEventListener('load', () => {
          const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {});
        });
      }

      // offline banner
      const status = document.querySelector<HTMLElement>('.net-status');
      const update = () => {
        if (!status) return;
        status.hidden = navigator.onLine;
        status.textContent = navigator.onLine
          ? ''
          : 'You are offline. Pages and photos you have already opened are still available.';
      };
      addEventListener('online', update);
      addEventListener('offline', update);
      update();
    </script>

    <style>
      .net-status {
        position: sticky;
        top: 0;
        z-index: 50;
        padding: 0.6rem var(--space-m);
        background: var(--wine);
        color: #fff;
        font-size: var(--step--1);
        text-align: center;
      }
      main:focus { outline: none; }
    </style>
  </body>
</html>
