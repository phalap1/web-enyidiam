---
// funeral programme from data/site.ts
import { funeral } from '../data/site';
import { url } from '../lib/url';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const fmt = (iso: string) => {
  const [h, m] = iso.slice(11, 16).split(':').map(Number);
  const suffix = h >= 12 ? 'pm' : 'am';
  return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')}${suffix}`;
};
const maps = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
---
<div class:list={['programme', { 'programme--compact': compact }]}>
  {funeral.map((day) => (
    <section class="programme__day" aria-labelledby={`day-${day.date}`}>
      <h3 class="programme__date" id={`day-${day.date}`}>
        <time datetime={day.date}>{day.label}</time>
      </h3>
      <ol class="programme__events" role="list">
        {day.events.map((e) => (
          <li class="programme__event">
            <p class="programme__time">
              <time datetime={`${e.start}+01:00`}>{fmt(e.start)}</time>
              {e.end && <> – <time datetime={`${e.end}+01:00`}>{fmt(e.end)}</time></>}
            </p>
            <div>
              <p class="programme__title">{e.title}</p>
              <p class="programme__venue">
                {e.mapQuery ? (
                  <a href={maps(e.mapQuery)} target="_blank" rel="noopener">{e.venue}<span class="visually-hidden"> (opens map)</span></a>
                ) : e.venue}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
  <p class="programme__actions button-row">
    <a class="button" href={url('funeral.ics')} download>Add to my calendar</a>
    {compact && <a class="button button--ghost" href={url('funeral')}>Full details</a>}
  </p>
</div>

<style>
  .programme { display: grid; gap: var(--space-l); }
  .programme__date {
    font-size: var(--step-2);
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-s);
    border-bottom: 1px solid var(--line);
  }
  .programme__events { display: grid; gap: var(--space-s); padding: 0; list-style: none; }
  .programme__event {
    display: grid;
    grid-template-columns: minmax(6.5rem, max-content) 1fr;
    gap: var(--space-s);
    align-items: baseline;
  }
  @media (max-width: 26rem) {
    .programme__event { grid-template-columns: 1fr; gap: 0; }
  }
  .programme__time {
    font-variant-numeric: tabular-nums;
    color: var(--copper);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }
  .programme__title { font-weight: 700; }
  .programme__venue { color: var(--ink-soft); font-size: var(--step--1); }
  .programme__actions { margin-top: var(--space-xs); }
</style>
