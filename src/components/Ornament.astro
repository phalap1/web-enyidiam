---
// gold divider from the posters
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class:list={['ornament', className]} viewBox="0 0 240 24" width="240" height="24" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
    <path d="M4 12h70" />
    <path d="M236 12h-70" />
    <path d="M74 12c10-9 22-9 30 0-8 9-20 9-30 0Z" />
    <path d="M166 12c-10-9-22-9-30 0 8 9 20 9 30 0Z" />
    <path d="M120 3l9 9-9 9-9-9Z" />
  </g>
  <circle cx="120" cy="12" r="2.2" fill="currentColor" />
  <circle cx="98" cy="12" r="1.4" fill="currentColor" />
  <circle cx="142" cy="12" r="1.4" fill="currentColor" />
</svg>

<style>
  .ornament {
    width: min(240px, 70%);
    height: auto;
    color: var(--gold);
    margin-inline: auto;
  }
</style>
