---
import Ornament from './Ornament.astro';
import { person, signedBy } from '../data/site';
import { url } from '../lib/url';
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <Ornament />
    <p class="site-footer__epitaph">{person.epitaph}</p>
    <p class="site-footer__sign">Signed: {signedBy.name}, <em>{signedBy.role}</em></p>
    <p class="site-footer__meta">
      In loving memory of {person.fullName} · {person.born} – {person.died}
      · <a href={url('funeral.ics')}>Add funeral dates to calendar</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-deep);
    color: #e9e3d6;
    padding-block: var(--space-l);
    text-align: center;
  }
  .site-footer__inner { display: grid; gap: var(--space-s); justify-items: center; }
  .site-footer__epitaph {
    font-family: var(--font-head);
    font-style: italic;
    font-weight: 500;
    font-size: var(--step-2);
    color: #fff;
    max-width: 30ch;
  }
  .site-footer__sign, .site-footer__meta { font-size: var(--step--1); }
  .site-footer a { color: var(--gold-soft); }
</style>
