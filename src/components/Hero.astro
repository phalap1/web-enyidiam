---
// homepage hero, lettering follows the burial poster
import { Picture, getImage } from 'astro:assets';
import Ornament from './Ornament.astro';
import { person } from '../data/site';
import { heroPortraits } from '../data/gallery';

const [first, ...rest] = heroPortraits;
const WIDTHS = [320, 480, 640, 832];
const SIZES = '(min-width: 56rem) 26rem, 72vw';
// the other portraits load only after the page has finished loading
const later = await Promise.all(
  rest.map(async (p) => {
    const set = async (format: 'avif' | 'webp') =>
      (await Promise.all(WIDTHS.filter((w) => w <= p.src.width).map(async (w) => {
        const img = await getImage({ src: p.src, width: w, format, quality: 62 });
        return `${img.src} ${w}w`;
      }))).join(', ');
    return { avif: await set('avif'), webp: await set('webp') };
  }),
);
---
<section class="hero" aria-labelledby="hero-name">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="hero__exit"><span class="eyebrow">Exit of</span> <span class="script hero__praise">{person.praiseName}</span></p>
      <Ornament />
      <h1 id="hero-name" class="hero__name">
        <span class="script hero__honorific">{person.honorific}</span>
        <span class="hero__first">{person.title} {person.firstName}</span>
        <span class="hero__christian">{person.christianName}</span>
        <span class="hero__surname">{person.surname}</span>
      </h1>
      <p class="hero__dates">
        <span class="hero__medal" aria-hidden="true"><small>Aged</small>{person.age}</span>
        <span>
          <time datetime={String(person.born)}>{person.born}</time> –
          <time datetime={String(person.died)}>{person.died}</time>
          <span class="visually-hidden">, aged {person.age}</span>
          <br /><span class="hero__town">{person.hometown}</span>
        </span>
      </p>
    </div>

    <div class="hero__frame">
      <div class="hero__portrait" role="img" aria-label={`Portraits of ${person.fullName}`} data-fade>
        <Picture
          src={first.src}
          alt=""
          formats={['avif']}
          fallbackFormat="webp"
          widths={WIDTHS}
          sizes={SIZES}
          quality={62}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero__img is-on"
        />
        {later.map((l) => (
          <picture>
            <source type="image/avif" data-srcset={l.avif} sizes={SIZES} />
            <img class="hero__img" data-srcset={l.webp} sizes={SIZES} alt="" decoding="async" />
          </picture>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-l) var(--space-xl);
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 50% at 100% 0%, rgb(195 211 236 / 60%), transparent 70%),
      radial-gradient(ellipse 55% 45% at 0% 100%, rgb(214 184 150 / 45%), transparent 70%),
      var(--ivory);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .hero__grid { grid-template-columns: 1.15fr 1fr; }
  }

  .hero__text { display: grid; gap: var(--space-s); text-align: center; justify-items: center; }
  @media (min-width: 56rem) { .hero__text { text-align: start; justify-items: start; } .hero__text :global(.ornament) { margin-inline: 0; } }

  .hero__exit { display: grid; line-height: 1; }
  .hero__praise { font-size: var(--step-4); color: var(--navy); }

  .hero__name { display: grid; gap: 0.1em; color: var(--navy); }
  .hero__honorific { font-size: var(--step-2); }
  .hero__first {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--step-1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .hero__christian {
    font-size: var(--step-4);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--navy);
    line-height: 0.95;
  }
  .hero__surname {
    font-size: var(--step-4);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 0.95;
  }

  .hero__dates {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    text-align: start;
    font-size: var(--step-1);
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--navy);
  }
  .hero__town { font-family: var(--font-body); font-weight: 400; font-size: var(--step--1); color: var(--ink-soft); }

  /* aged 78 badge */
  .hero__medal {
    flex: none;
    display: grid;
    place-content: center;
    width: 5.2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #9b2a35, var(--wine) 70%);
    box-shadow: 0 0 0 3px var(--ivory), 0 0 0 5px var(--gold);
    color: #fff;
    font-family: var(--font-head);
    font-size: 2.1rem;
    line-height: 0.9;
    text-align: center;
  }
  .hero__medal small {
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  .hero__frame { justify-self: center; }
  .hero__portrait {
    width: min(26rem, 72vw);
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px var(--radius) var(--radius);
    overflow: hidden;
    background: var(--paper-deep);
    box-shadow: 0 0 0 6px var(--ivory), 0 0 0 7px var(--gold), var(--shadow);
  }
  .hero__portrait { position: relative; }
  .hero__portrait :global(picture) { position: absolute; inset: 0; }
  .hero__portrait :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    opacity: 0;
    transition: opacity 1.8s ease-in-out;
  }
  .hero__portrait :global(.hero__img.is-on) { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .hero__portrait :global(.hero__img) { transition: none; } }
</style>

<script>
  // Fade gently between her portraits in a random order. The first portrait is
  // the only one loaded up front; the rest wait until the page has loaded.
  const frame = document.querySelector<HTMLElement>('[data-fade]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  if (frame && !still.matches) {
    const start = () => {
      const imgs = [...frame.querySelectorAll<HTMLImageElement>('img')];
      const [, ...others] = imgs;
      frame.querySelectorAll<HTMLElement>('[data-srcset]').forEach((el) => {
        el.setAttribute('srcset', el.dataset.srcset!);
        el.removeAttribute('data-srcset');
      });
      const ready = (i: HTMLImageElement) => i.complete && i.naturalWidth > 0;
      let current = imgs[0];
      let queue: HTMLImageElement[] = [];
      const next = () => {
        if (!queue.length) {
          // shuffle, never repeating the one on screen
          queue = imgs.filter((i) => i !== current).sort(() => Math.random() - 0.5);
        }
        return queue.shift()!;
      };
      setInterval(() => {
        if (document.hidden) return;
        const n = next();
        if (!ready(n)) { queue.push(n); return; } // still downloading on a slow line
        n.classList.add('is-on');
        current.classList.remove('is-on');
        current = n;
      }, 7000);
      others.forEach((i) => i.decode?.().catch(() => {}));
    };
    if (document.readyState === 'complete') start();
    else addEventListener('load', start, { once: true });
  }
</script>
